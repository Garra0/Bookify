{
  "ConnectionStrings": {
    "Database": "Host=bookify-db;Port=5432;Database=bookify;Username=postgres;Password=postgres;",
    "Cache": "bookify-redis:6379"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Bookify.Infrastructure": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://bookify-seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://bookify-idp:8080/realms/master",
    "MetadataUrl": "http://bookify-idp:8080/realms/master/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://bookify-idp:8080",
    "AdminUrl": "http://bookify-idp:8080/admin/realms/master/",
    "TokenUrl": "http://bookify-idp:8080/realms/master/protocol/openid-connect/token",
    "AdminClientId": "bookify-admin-client",
    "AdminClientSecret": "1imWxmfXnVfKKAtDos5CXH9gUDkACSeeBydctoSNgxrMMYqAlMowZKaXcQrz4KDEDf4HkM7QUu7iChepXgbhAL",
    "AuthClientId": "bookify-auth-client",
    "AuthClientSecret": "KUn8FNDzyOlGGgpGKtLOWaFhYbvP41n6smZ6Wk4xDAt3hBVr1nnS4vp8ERlEBAaEw66TGxaaFAQoUPjU19kSvW"
  },
  "Outbox": {
    "IntervalInSeconds": 60,
    "BatchSize": 10
  }
}
